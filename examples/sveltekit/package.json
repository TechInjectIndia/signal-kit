{
  "name": "@signalkit/example-sveltekit",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 3400",
    "build": "bun --bun vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "bun build/index.js"
  },
  "dependencies": {
    "@techinject/sveltekit": "workspace:*",
    "@techinject/sveltekit-server": "workspace:*",
    "@techinject/contracts": "workspace:*",
    "@techinject/browser": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.4",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  }
}
