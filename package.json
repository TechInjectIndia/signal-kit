{
  "name": "signalkit-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @signalkit/example-nextjs dev",
    "dev:all": "pnpm --parallel --filter \"@signalkit/example-nextjs\" --filter \"@signalkit/example-bun\" dev",
    "dev:bun": "pnpm --filter @signalkit/example-bun dev",
    "dev:sveltekit": "pnpm --filter @signalkit/example-sveltekit dev",
    "dev:site": "pnpm --filter @signalkit/site dev",
    "test:bun": "pnpm --filter @signalkit/example-bun test",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "node scripts/repository-check.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "test:boundaries": "node scripts/boundary-check.mjs",
    "test:next-otel": "node scripts/next-otel-smoke.mjs",
    "test:packages": "node scripts/package-check.mjs",
    "test:bundle": "node scripts/bundle-check.mjs",
    "test:site:e2e": "playwright test --config playwright.site.config.ts",
    "site:og": "node scripts/generate-site-og.mjs",
    "site:publish": "node scripts/publish-site.mjs",
    "release:prepare": "node scripts/prepare-alpha.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "test:alpha": "node scripts/test-alpha-installer.mjs",
    "test:sveltekit": "playwright test --config playwright.sveltekit.config.ts",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "node scripts/publish-packages.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "release:cleanup-tags": "node scripts/cleanup-alpha-tags.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechInjectIndia/signal-kit.git"
  },
  "homepage": "https://github.com/TechInjectIndia/signal-kit#readme",
  "bugs": {
    "url": "https://github.com/TechInjectIndia/signal-kit/issues"
  }
}
