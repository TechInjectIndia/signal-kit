{
  "name": "signalkit-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/features/*/*",
    "examples/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun scripts/repository-check.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "test:boundaries": "bun scripts/boundary-check.mjs",
    "test:next-otel": "bun scripts/next-otel-smoke.mjs",
    "test:packages": "bun scripts/package-check.mjs",
    "test:consumers": "bun scripts/consumer-smoke.mjs",
    "test:bundle": "bun scripts/bundle-check.mjs",
    "test:site:e2e": "playwright test --config playwright.site.config.ts",
    "site:og": "bun scripts/generate-site-og.mjs",
    "site:publish": "bun scripts/publish-site.mjs",
    "release:prepare": "bun scripts/prepare-alpha.mjs",
    "demo:record": "bun scripts/record-demo.mjs",
    "test:alpha": "bun scripts/test-alpha-installer.mjs",
    "test:sveltekit": "playwright test --config playwright.sveltekit.config.ts",
    "changeset": "changeset",
    "release:version": "changeset version && bun install --lockfile-only",
    "release:publish": "bun scripts/publish-packages.mjs",
    "test:release": "bun test ./scripts/release.test.mjs",
    "release:cleanup-tags": "bun scripts/cleanup-alpha-tags.mjs"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechInjectIndia/signal-kit.git"
  },
  "homepage": "https://github.com/TechInjectIndia/signal-kit#readme",
  "bugs": {
    "url": "https://github.com/TechInjectIndia/signal-kit/issues"
  }
}
