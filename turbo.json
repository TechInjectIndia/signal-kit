{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@signalkit/example-bun#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "SIGNALKIT_DEMO_DB", "RAZORPAY_WEBHOOK_SECRET"]
    },
    "@signalkit/site#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "SITE_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".svelte-kit/**", "build/**"],
      "env": ["SITE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalEnv": [
    "SIGNALKIT_OTEL_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "agentGuidance": false,
  "globalDependencies": ["scripts/build-cdn.mjs", "scripts/files.mjs", "LICENSE"]
}
